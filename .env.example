# Copy to .env and fill in. NEVER commit .env.

# Where built bounty projects get pushed. Used only to label/attribute repos.
GITHUB_USER=23071183-sys

# Your payout wallet address (public address ONLY — never a private key/seed phrase).
# Stored as plain config and shown in submission drafts. Claude never touches keys or funds.
PAYOUT_WALLET=0x0000000000000000000000000000000000000000
PAYOUT_WALLET_CHAIN=ethereum

# Optional: platform API tokens (most discovery works without these).
DEWORK_API_TOKEN=
GITCOIN_API_KEY=

# Optional: USD conversion. If set, used to value non-USD rewards.
# Comma list of SYMBOL:USD overrides, e.g. ETH:3500,OP:2.1,USDC:1
TOKEN_USD_OVERRIDES=USDC:1,USDT:1,DAI:1
